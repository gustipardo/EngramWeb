---
import type { Locale } from '../i18n';
import Head from '../components/Head.astro';
import PixelLogo from '../components/PixelLogo.astro';
import PxIcon from '../components/PxIcon.astro';
import { SITE_URL } from '../lib/site';

interface Props {
  locale: Locale;
  /** Page <title> and on-page H1. */
  title: string;
  /** Short meta description for SEO. */
  description: string;
  /** Human-readable effective date, already localized by the page. */
  effective: string;
  /** Path of the same document in the other locale, for hreflang. */
  altPath: string;
  /** Path of this document in the current locale, for canonical. */
  selfPath: string;
}

const { locale, title, description, effective, altPath, selfPath } = Astro.props;
const altLocale = locale === 'es' ? 'en' : 'es';
const home = locale === 'es' ? '/' : '/en/';
const backLabel = locale === 'es' ? 'Volver a Engram' : 'Back to Engram';
const updatedLabel = locale === 'es' ? 'Vigente desde' : 'Effective';
const nightLabels =
  locale === 'es'
    ? { night: 'Cambiar a la mesa de noche', day: 'Cambiar a la mesa de día' }
    : { night: 'Switch to the night table', day: 'Switch to the day table' };
const trademark =
  locale === 'es'
    ? 'Anki y AnkiDroid son marcas de sus respectivos dueños. Engram es un producto independiente, sin relación ni aval de ellos.'
    : 'Anki and AnkiDroid are trademarks of their respective owners. Engram is an independent product and is not affiliated with or endorsed by them.';
---

<!doctype html>
<html lang={locale} class="no-js" data-pal="stone" data-theme="gold" data-night="0">
  <head>
    <Head title={`${title} · Engram`} description={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${SITE_URL}${selfPath}`} />
    <link rel="alternate" hreflang={locale} href={`${SITE_URL}${selfPath}`} />
    <link rel="alternate" hreflang={altLocale} href={`${SITE_URL}${altPath}`} />
  </head>

  <body>
    <header class="rule-b">
      <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-5 sm:px-8">
        <a href={home} class="flex items-center gap-2.5">
          <PixelLogo n={24} width={28} />
          <span class="wordmark text-[22px] leading-none">Engram</span>
        </a>
        <button
          type="button"
          class="btn btn-o btn-sm w-9 px-0"
          data-night-toggle
          data-label-day={nightLabels.day}
          data-label-night={nightLabels.night}
          aria-label={nightLabels.night}
        >
          <PxIcon name="moon" class="when-day" />
          <PxIcon name="sun" class="when-night" />
        </button>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-5 py-12 sm:px-8 sm:py-16">
      <a href={home} class="inline-flex items-center gap-2 font-mono text-[12px] uppercase tracking-[0.08em]" style="color:var(--mesa-ink3)">
        <span class="inline-block rotate-180"><PxIcon name="arrow" size={12} /></span>
        {backLabel}
      </a>

      <div class="mt-8 pb-8 rule-b">
        <h1 class="disp text-[clamp(32px,5vw,48px)]">{title}</h1>
        <p class="kicker mt-4">{updatedLabel} {effective}</p>
      </div>

      <article class="legal-prose mt-10">
        <slot />
      </article>
    </main>

    <footer class="mx-auto max-w-3xl px-5 pb-12 sm:px-8">
      <div class="rule-t grid gap-1 pt-8 font-mono text-[11.5px] leading-relaxed" style="color:var(--mesa-ink3)">
        <p>&copy; {new Date().getFullYear()} Engram · Tobías Pardo · UTN Facultad Regional Delta</p>
        <p>{trademark}</p>
      </div>
    </footer>

    <script>
      import '../scripts/mesa';
    </script>

    <style is:global>
      .legal-prose {
        font-size: 16px;
        line-height: 1.75;
        color: var(--mesa-ink2);
      }
      .legal-prose h2 {
        font: 700 21px/1.3 var(--ui);
        letter-spacing: -0.01em;
        margin-top: 2.6rem;
        margin-bottom: 0.8rem;
        color: var(--mesa-ink);
      }
      .legal-prose h3 {
        font: 600 17px/1.4 var(--ui);
        margin-top: 1.8rem;
        margin-bottom: 0.5rem;
        color: var(--mesa-ink);
      }
      .legal-prose p {
        margin-block: 0.85rem;
      }
      .legal-prose ul,
      .legal-prose ol {
        padding-left: 1.4rem;
        margin-block: 0.75rem 0.95rem;
      }
      .legal-prose ul {
        list-style: square;
      }
      .legal-prose ol {
        list-style: decimal;
      }
      .legal-prose li {
        margin-block: 0.35rem;
      }
      .legal-prose li::marker {
        color: var(--mesa-back);
      }
      .legal-prose strong {
        font-weight: 600;
        color: var(--mesa-ink);
      }
      .legal-prose a {
        color: var(--mesa-ink);
        text-decoration: underline;
        text-decoration-color: var(--mesa-back);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
      }
      .legal-prose .lead {
        font-size: 17.5px;
        line-height: 1.7;
        color: var(--mesa-ink);
      }
      .legal-prose .summary {
        --s: 6px;
        --h: 3px;
        clip-path: var(--notch);
        margin-top: 1.5rem;
        background: var(--mesa-surface);
        box-shadow: inset 0 0 0 1px var(--mesa-rule);
        padding: 1.1rem 1.25rem;
      }
      .legal-prose .summary p {
        margin: 0;
        font-size: 15px;
      }
      .legal-prose .summary p + p {
        margin-top: 0.5rem;
      }
    </style>
  </body>
</html>
