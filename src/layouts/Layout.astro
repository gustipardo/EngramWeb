---
import type { Locale } from '../i18n';
import { t } from '../i18n';
import Head from '../components/Head.astro';
import { PRO_MONTHLY_USD, SITE_URL } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const altLocale = locale === 'es' ? 'en' : 'es';
const currentPath = locale === 'es' ? '/' : '/en/';
const altPath = locale === 'es' ? '/en/' : '/';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: i.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Engram',
  alternateName: ['Conversational Flashcards', 'Flashcards Conversacionales'],
  operatingSystem: 'Android',
  applicationCategory: 'EducationalApplication',
  description: i.meta.description,
  url: `${SITE_URL}${currentPath}`,
  offers: [
    { '@type': 'Offer', name: i.pricing.free.label, price: '0', priceCurrency: 'USD' },
    {
      '@type': 'Offer',
      name: i.pricing.pro.label,
      price: PRO_MONTHLY_USD,
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: PRO_MONTHLY_USD,
        priceCurrency: 'USD',
        unitText: 'MONTH',
      },
    },
  ],
};
---

<!doctype html>
<html lang={locale} class="no-js" data-pal="stone" data-theme="gold" data-night="0">
  <head>
    <Head title={i.meta.title} description={i.meta.description} />
    <link rel="canonical" href={`${SITE_URL}${currentPath}`} />
    <link rel="alternate" hreflang={locale} href={`${SITE_URL}${currentPath}`} />
    <link rel="alternate" hreflang={altLocale} href={`${SITE_URL}${altPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/`} />

    <meta property="og:title" content={i.meta.title} />
    <meta property="og:description" content={i.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE_URL}${currentPath}`} />
    <meta property="og:locale" content={locale === 'es' ? 'es_AR' : 'en_US'} />
    <meta property="og:image" content={`${SITE_URL}/og-${locale}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={i.meta.title} />
    <meta name="twitter:description" content={i.meta.description} />
    <meta name="twitter:image" content={`${SITE_URL}/og-${locale}.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">{i.skip}</a>
    <slot />
    <script>
      import '../scripts/mesa';
    </script>
  </body>
</html>
