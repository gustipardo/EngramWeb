---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const altLocale = locale === 'es' ? 'en' : 'es';
const siteUrl = 'https://engramcards.com';
const currentPath = locale === 'es' ? '/' : '/en/';
const altPath = locale === 'es' ? '/en/' : '/';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: i.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Engram · Conversational Flashcards',
  alternateName: 'Anki Conversacionales',
  operatingSystem: 'Android',
  applicationCategory: 'EducationalApplication',
  description: i.meta.description,
  offers: {
    '@type': 'Offer',
    price: '5.00',
    priceCurrency: 'USD',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '5.00',
      priceCurrency: 'USD',
      unitText: 'MONTH',
    },
  },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={i.meta.description} />
    <meta name="theme-color" content="#FAF7F1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1020" media="(prefers-color-scheme: dark)" />

    <!-- Theme-init: runs before body paints to prevent FOUC. Default is light; dark only when user opted in. -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('engram-theme') === 'dark') {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    <title>{i.meta.title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={`${siteUrl}${currentPath}`} />
    <link rel="alternate" hreflang={locale} href={`${siteUrl}${currentPath}`} />
    <link rel="alternate" hreflang={altLocale} href={`${siteUrl}${altPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={i.meta.title} />
    <meta property="og:description" content={i.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}${currentPath}`} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={i.meta.title} />
    <meta name="twitter:description" content={i.meta.description} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />
  </head>
  <body class="min-h-screen bg-paper-100 font-body text-navy-900 antialiased transition-colors duration-300 selection:bg-amber-500/30 selection:text-navy-900 dark:bg-navy-900 dark:text-paper-100 dark:selection:text-paper-50">
    <slot />
  </body>
</html>
