---
// Beta testers' download page: the APK sideload until the Play closed test
// exists. Spanish only, kept out of search and the sitemap. The button's
// target is a redirect in public/_redirects (/beta/engram.apk).
import Head from '../components/Head.astro';
import PixelLogo from '../components/PixelLogo.astro';
import PxIcon from '../components/PxIcon.astro';
import { SUPPORT_EMAIL } from '../lib/site';

const APK_PATH = '/beta/engram.apk';
const APK_SIZE = '127 MB';

const steps = [
  {
    title: 'Descargá el archivo',
    body: 'Tocá el botón desde el celular. Es un APK de 127 MB: conviene bajarlo con wifi.',
  },
  {
    title: 'Abrilo e instalalo',
    body: 'Android te va a pedir permiso para instalar apps desde el navegador. Dáselo para esta instalación; podés quitarlo después en Ajustes.',
  },
  {
    title: 'Iniciá sesión con Google',
    body: 'Usá el Gmail que le pasaste a Gusti: esa cuenta tiene los minutos de voz de la beta.',
  },
];
---

<!doctype html>
<html lang="es" class="no-js" data-pal="stone" data-theme="gold" data-night="0">
  <head>
    <Head
      title="Beta para Android · Engram"
      description="Descargá la beta de Engram para Android: estudiá tus mazos hablando con un tutor."
    />
    <meta name="robots" content="noindex, nofollow" />
  </head>

  <body>
    <header class="rule-b">
      <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-5 sm:px-8">
        <a href="/" class="flex items-center gap-2.5">
          <PixelLogo n={24} width={28} />
          <span class="wordmark text-[22px] leading-none">Engram</span>
        </a>
        <button
          type="button"
          class="btn btn-o btn-sm w-9 px-0"
          data-night-toggle
          data-label-day="Cambiar a la mesa de día"
          data-label-night="Cambiar a la mesa de noche"
          aria-label="Cambiar a la mesa de noche"
        >
          <PxIcon name="moon" class="when-day" />
          <PxIcon name="sun" class="when-night" />
        </button>
      </div>
    </header>

    <main>
      <section class="mat" aria-labelledby="beta-h">
        <div class="mx-auto grid max-w-3xl justify-items-center px-5 py-16 text-center sm:px-8 sm:py-24">
          <PixelLogo n={96} width={120} animate />
          <p class="kicker mt-8">Beta cerrada · Android</p>
          <h1 id="beta-h" class="disp mt-4 max-w-[16ch] text-[clamp(36px,7vw,64px)]">
            Estudiá tus mazos hablando
          </h1>
          <p class="mt-5 max-w-[32rem] text-[17px] leading-relaxed" style="color:var(--mesa-on-felt2)">
            Engram te lee cada tarjeta, escucha tu respuesta y la califica. Vos
            solo hablás. Esta es la versión de prueba, antes de Google Play.
          </p>
          <a href={APK_PATH} class="btn btn-back drop beta-dl mt-10" download="engram-beta.apk">
            <PxIcon name="down" />
            Descargar Engram
          </a>
          <p class="mt-4 font-mono text-[12px]" style="color:var(--mesa-on-felt2)">
            APK · {APK_SIZE} · Android 7 o superior
          </p>
        </div>
      </section>

      <section class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20" aria-labelledby="steps-h">
        <h2 id="steps-h" class="kicker">Cómo instalarla</h2>
        <ol class="mt-6 grid gap-4">
          {steps.map((step, i) => (
            <li class="beta-step">
              <span class="disp text-[28px]" style="color:var(--mesa-back)">{i + 1}</span>
              <div>
                <h3 class="text-[17px] font-semibold" style="color:var(--mesa-ink)">{step.title}</h3>
                <p class="mt-1 text-[15px] leading-relaxed" style="color:var(--mesa-ink2)">{step.body}</p>
              </div>
            </li>
          ))}
        </ol>

        <h2 class="kicker mt-14">Antes de empezar</h2>
        <ul class="beta-notes mt-5">
          <li>
            <strong>Es una beta.</strong> Puede fallar. Si algo no anda, contalo
            desde Cuenta → Enviar comentarios, o escribí a
            <a href={`mailto:${SUPPORT_EMAIL}?subject=Beta%20de%20Engram`}>{SUPPORT_EMAIL}</a>.
          </li>
          <li>
            <strong>Registra cómo la usás</strong> (pantallas, sesiones,
            calificaciones, errores) para saber qué mejorar. No guarda el audio
            de tu voz.
          </li>
          <li>
            <strong>Para actualizar</strong>, volvé a esta página e instalá
            encima. Tus mazos y tu progreso quedan.
          </li>
          <li>
            Si la primera vez que la abrís queda la pantalla en blanco, cerrala
            y volvé a abrirla.
          </li>
        </ul>
      </section>
    </main>

    <footer class="mx-auto max-w-3xl px-5 pb-12 sm:px-8">
      <div class="rule-t grid gap-1 pt-8 font-mono text-[11.5px] leading-relaxed" style="color:var(--mesa-ink3)">
        <p>&copy; {new Date().getFullYear()} Engram · Tobías Pardo · UTN Facultad Regional Delta</p>
        <p>
          <a href="/privacy" class="underline">Privacidad</a> ·
          <a href="/terms" class="underline">Términos</a>
        </p>
      </div>
    </footer>

    <script>
      import '../scripts/mesa';
    </script>

    <style>
      .beta-dl {
        height: 68px;
        padding: 0 40px;
        font-size: 20px;
        gap: 12px;
        width: min(100%, 22rem);
      }
      .beta-dl :global(svg) {
        width: 22px;
        height: 22px;
      }
      .beta-step {
        --s: 6px;
        --h: 3px;
        clip-path: var(--notch);
        display: grid;
        grid-template-columns: 2.2rem 1fr;
        gap: 0.75rem;
        align-items: start;
        background: var(--mesa-surface);
        box-shadow: inset 0 0 0 1px var(--mesa-rule);
        padding: 1.1rem 1.25rem;
      }
      .beta-notes {
        display: grid;
        gap: 0.8rem;
        padding-left: 1.2rem;
        list-style: square;
        font-size: 15px;
        line-height: 1.65;
        color: var(--mesa-ink2);
      }
      .beta-notes li::marker {
        color: var(--mesa-back);
      }
      .beta-notes strong {
        font-weight: 600;
        color: var(--mesa-ink);
      }
      .beta-notes a {
        color: var(--mesa-ink);
        text-decoration: underline;
        text-decoration-color: var(--mesa-back);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
      }
    </style>
  </body>
</html>
