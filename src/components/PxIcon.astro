---
import { ICON, iconSvg } from '../lib/pixel';

interface Props {
  name: keyof typeof ICON;
  size?: number;
  class?: string;
}
const { name, size = 16, class: cls = '' } = Astro.props;
---

<span class:list={['inline-block shrink-0', cls]} style={`width:${size}px;height:${size}px`} set:html={iconSvg(name)} />
