---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
---

<section class="border-b border-paper-300 bg-paper-100 transition-colors dark:border-navy-800 dark:bg-navy-900">
  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
    <ul class="flex flex-wrap items-center gap-x-8 gap-y-3 font-mono text-xs text-navy-500 dark:text-paper-100/50">
      {
        i.trustStrip.items.map((item) => (
          <li class="flex items-center gap-2">
            <span class="inline-block h-1 w-1 rounded-full bg-amber-600 dark:bg-amber-500" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
