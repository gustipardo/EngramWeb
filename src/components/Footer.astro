---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const year = new Date().getFullYear();
// Legal pages live at the locale root (ES default, /en/ for English).
const legalBase = locale === 'es' ? '' : '/en';
---

<footer class="bg-paper-100 py-16 text-navy-500 transition-colors dark:bg-navy-900 dark:text-paper-100/60">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid gap-12 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5">
          <!-- Light mark -->
          <svg viewBox="0 0 200 200" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="shrink-0 dark:hidden">
            <rect x="28" y="30" width="108" height="140" rx="11.6" fill="#B87826"/>
            <rect x="51.76" y="68.8" width="60.48" height="6.4" rx="3.2" fill="#FAF7F1"/>
            <rect x="51.76" y="113.6" width="60.48" height="6.4" rx="3.2" fill="#FAF7F1" opacity=".55"/>
            <line x1="150" y1="81" x2="173.12" y2="68.71" stroke="#B87826" stroke-width="7.6" stroke-linecap="round" opacity="0.5"/>
            <line x1="150" y1="100" x2="183.88" y2="100" stroke="#B87826" stroke-width="7.6" stroke-linecap="round" opacity="0.9"/>
            <line x1="150" y1="119" x2="173.12" y2="131.29" stroke="#B87826" stroke-width="7.6" stroke-linecap="round" opacity="0.5"/>
          </svg>
          <!-- Dark mark -->
          <svg viewBox="0 0 200 200" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="hidden shrink-0 dark:block">
            <rect x="28" y="30" width="108" height="140" rx="11.6" fill="#E4A13F"/>
            <rect x="51.76" y="68.8" width="60.48" height="6.4" rx="3.2" fill="#0B1020"/>
            <rect x="51.76" y="113.6" width="60.48" height="6.4" rx="3.2" fill="#0B1020" opacity=".55"/>
            <line x1="150" y1="81" x2="173.12" y2="68.71" stroke="#E4A13F" stroke-width="7.6" stroke-linecap="round" opacity="0.5"/>
            <line x1="150" y1="100" x2="183.88" y2="100" stroke="#E4A13F" stroke-width="7.6" stroke-linecap="round" opacity="0.9"/>
            <line x1="150" y1="119" x2="173.12" y2="131.29" stroke="#E4A13F" stroke-width="7.6" stroke-linecap="round" opacity="0.5"/>
          </svg>
          <span class="font-display text-lg font-medium text-navy-900 dark:text-paper-100">engram</span>
        </div>
        <p class="mt-5 max-w-sm text-sm leading-relaxed">{i.footer.tagline}</p>
        <p class="mt-4 font-mono text-xs text-navy-400 dark:text-paper-100/40">{i.footer.builtBy}</p>

        <!-- Theme toggle -->
        <div class="mt-8 inline-flex items-center gap-3 rounded-full border border-paper-300 bg-paper-50 p-1 dark:border-navy-800 dark:bg-navy-850">
          <span class="pl-3 font-mono text-[10px] uppercase tracking-widest text-navy-400 dark:text-paper-100/40">{i.footer.theme.label}</span>
          <button
            id="theme-toggle"
            type="button"
            class="group flex items-center gap-2 rounded-full bg-amber-600 px-3 py-1.5 text-xs font-semibold text-paper-100 transition-colors hover:bg-amber-700 dark:bg-amber-500 dark:text-navy-900 dark:hover:bg-amber-300"
            aria-label="Toggle theme"
          >
            <!-- Sun icon (shown in dark mode) -->
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2" /><path d="M12 20v2" />
              <path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" />
              <path d="M2 12h2" /><path d="M20 12h2" />
              <path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <span class="dark:hidden">{i.footer.theme.dark}</span>
            <span class="hidden dark:inline">{i.footer.theme.light}</span>
          </button>
        </div>
      </div>

      <div>
        <h5 class="font-mono text-xs uppercase tracking-widest text-navy-400 dark:text-paper-100/40">{i.footer.sections.product}</h5>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="#features" class="transition-colors hover:text-navy-900 dark:hover:text-paper-100">{i.footer.links.features}</a></li>
          <li><a href="#how-it-works" class="transition-colors hover:text-navy-900 dark:hover:text-paper-100">{i.footer.links.howItWorks}</a></li>
          <li><a href="#pricing" class="transition-colors hover:text-navy-900 dark:hover:text-paper-100">{i.footer.links.pricing}</a></li>
          <li><a href="#faq" class="transition-colors hover:text-navy-900 dark:hover:text-paper-100">{i.footer.links.faq}</a></li>
          <li><a href="#download" class="transition-colors hover:text-amber-700 dark:hover:text-amber-500">{i.footer.links.download}</a></li>
        </ul>
      </div>

      <div>
        <h5 class="font-mono text-xs uppercase tracking-widest text-navy-400 dark:text-paper-100/40">{i.footer.sections.legal}</h5>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href={`${legalBase}/privacy`} class="transition-colors hover:text-navy-900 dark:hover:text-paper-100">{i.footer.links.privacy}</a></li>
          <li><a href={`${legalBase}/terms`} class="transition-colors hover:text-navy-900 dark:hover:text-paper-100">{i.footer.links.terms}</a></li>
          <li><a href="mailto:support@engramcards.com" class="transition-colors hover:text-navy-900 dark:hover:text-paper-100">{i.footer.links.contact}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-3 border-t border-paper-300 pt-8 text-xs text-navy-400 md:flex-row md:items-center dark:border-navy-800 dark:text-paper-100/40">
      <p class="font-mono">&copy; {year} {i.footer.copyright}</p>
      <p class="font-mono">Flashcards Conversacionales · Anki is a trademark of its owners. We just respect it.</p>
    </div>
  </div>
</footer>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.classList.toggle('dark');
    try {
      localStorage.setItem('engram-theme', isDark ? 'dark' : 'light');
    } catch (e) {}
  });
</script>
