---
import type { Locale } from '../i18n';
import { t } from '../i18n';
import { SUPPORT_EMAIL } from '../lib/site';
import PixelLogo from './PixelLogo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const f = i.footer;
const year = new Date().getFullYear();
// Legal pages live at the locale root (ES default, /en/ for English).
const base = locale === 'es' ? '' : '/en';
---

<footer class="rule-t py-14">
  <div class="wrap grid gap-10 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)]">
    <div>
      <div class="flex items-center gap-2.5">
        <PixelLogo n={24} width={26} />
        <span class="wordmark text-[21px] leading-none">Engram</span>
      </div>
      <p class="mt-4 max-w-sm text-[14.5px] leading-relaxed" style="color:var(--mesa-ink2)">{f.tagline}</p>
      <p class="mt-3 font-mono text-[12px]" style="color:var(--mesa-ink3)">{f.builtBy}</p>
    </div>
    <nav aria-labelledby="foot-product">
      <h2 id="foot-product" class="kicker">{f.product}</h2>
      <ul class="mt-4 grid gap-2 text-[14.5px]">
        <li><a class="foot-link" href="#session">{i.nav.session}</a></li>
        <li><a class="foot-link" href="#decks">{i.nav.decks}</a></li>
        <li><a class="foot-link" href="#pricing">{i.nav.pricing}</a></li>
        <li><a class="foot-link" href="#faq">{i.nav.faq}</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="foot-legal">
      <h2 id="foot-legal" class="kicker">{f.legal}</h2>
      <ul class="mt-4 grid gap-2 text-[14.5px]">
        <li><a class="foot-link" href={`${base}/privacy`}>{f.links.privacy}</a></li>
        <li><a class="foot-link" href={`${base}/terms`}>{f.links.terms}</a></li>
        <li><a class="foot-link" href={`${base}/delete-account`}>{f.links.deleteAccount}</a></li>
        <li><a class="foot-link" href={`mailto:${SUPPORT_EMAIL}`}>{f.links.contact}</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap mt-12">
    <div class="rule-t grid gap-2 pt-6 font-mono text-[11.5px] leading-relaxed" style="color:var(--mesa-ink3)">
      <p>&copy; {year} {f.copyright}</p>
      <p>{f.trademark}</p>
    </div>
  </div>
</footer>

<style>
  .foot-link {
    color: var(--mesa-ink2);
    transition: color 0.15s var(--ease);
  }
  .foot-link:hover {
    color: var(--mesa-ink);
  }
</style>
