---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
---

<section class="border-y border-paper-300 bg-paper-200/70 transition-colors dark:border-navy-800 dark:bg-navy-850">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-4 px-4 py-16 sm:px-6 sm:py-20 md:flex-row md:items-center md:justify-between md:gap-12">
    <h2 class="font-display text-3xl font-medium leading-tight text-navy-900 sm:text-4xl md:text-5xl dark:text-paper-100 [font-variation-settings:'opsz'_72]">
      {i.manifesto.title}
    </h2>
    <p class="max-w-md text-lg leading-relaxed text-navy-500 dark:text-paper-100/60">
      {i.manifesto.subtitle}
    </p>
  </div>
</section>
