---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
---

<section class="rule-b">
  <div class="wrap grid gap-5 py-14 sm:py-16 md:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] md:items-center md:gap-12">
    <h2 class="disp reveal text-[clamp(30px,4vw,46px)] leading-[1.02]">{i.manifesto.title}</h2>
    <p class="reveal max-w-md text-[17px] leading-relaxed" style="color:var(--mesa-ink2)">{i.manifesto.body}</p>
  </div>
</section>
