---
import type { Locale } from '../i18n';
import { t } from '../i18n';
import PxIcon from './PxIcon.astro';
import SessionDemo from './SessionDemo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
---

<section class="mat hero">
  <div class="wrap grid items-center gap-x-14 gap-y-12 pb-16 pt-12 sm:pt-16 lg:grid-cols-[minmax(0,1.08fr)_minmax(0,1fr)] lg:pb-24 lg:pt-20">
    <div>
      <p class="kicker">{i.hero.kicker}</p>
      <h1 class="disp hero-title mt-5">{i.hero.title}</h1>
      <p class="hero-lede mt-6 max-w-[34rem] text-[18px] leading-relaxed sm:text-[19px]">{i.hero.lede}</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#download" class="btn btn-back btn-lg drop">
          <PxIcon name="down" />
          {i.hero.ctaPrimary}
        </a>
        <a href="#session" class="btn btn-o btn-lg">
          {i.hero.ctaSecondary}
          <PxIcon name="arrow" />
        </a>
      </div>
      <p class="mt-6 font-mono text-[12px] tracking-wide" style="color:var(--mesa-on-felt2)">{i.hero.hint}</p>
    </div>

    <SessionDemo locale={locale} />
  </div>
</section>

<style>
  .hero-title {
    font-size: clamp(44px, 6.3vw, 82px);
  }
  .hero-lede {
    color: var(--mesa-on-felt2);
  }
</style>
