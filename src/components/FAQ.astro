---
import type { Locale } from '../i18n';
import { t } from '../i18n';
import PxIcon from './PxIcon.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale).faq;
const privacy = locale === 'es' ? '/privacy' : '/en/privacy';
---

<section id="faq" class="scroll-mt-16 rule-t py-16 sm:py-24" aria-labelledby="faq-h">
  <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.6fr)]">
    <div>
      <SectionHead id="faq-h" eyebrow={i.eyebrow} title={i.title} />
      <a href={privacy} class="reveal mt-6 inline-flex items-center gap-2 text-[15px] font-medium underline underline-offset-4">
        {i.privacyLink}
        <PxIcon name="arrow" size={13} />
      </a>
    </div>
    <div class="reveal faq-list">
      {
        i.items.map((item) => (
          <details class="faq-item group">
            <summary>
              <span>{item.question}</span>
              <PxIcon name="plus" size={14} class="faq-plus" />
            </summary>
            <p class="max-w-[40rem] pb-6 text-[16px] leading-relaxed" style="color:var(--mesa-ink2)">
              {item.answer}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-list {
    border-top: 2px solid var(--mesa-ink);
  }
  .faq-item {
    border-bottom: 1px solid var(--mesa-rule);
  }
  .faq-item summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 20px 0;
    cursor: pointer;
    font: 600 18px/1.35 var(--ui);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item :global(.faq-plus) {
    transition: transform 0.25s var(--ease);
  }
  .faq-item[open] :global(.faq-plus) {
    transform: rotate(45deg);
  }
</style>
