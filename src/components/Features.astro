---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);

const icons = [
  '<path d="M20 6 9 17l-5-5"/><path d="m3 12 3 3 7-7"/>',
  '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/>',
  '<path d="M6 3v12a6 6 0 0 0 12 0V3"/><path d="M4 21h16"/>',
  '<path d="M12 2 3 7v5a10 10 0 0 0 9 10 10 10 0 0 0 9-10V7Z"/><path d="m9 12 2 2 4-4"/>',
  '<path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-6"/>',
  '<path d="M4 10c0-3 3-5 7-5s7 2 7 5-3 5-7 5H8l-4 3Z"/>',
];
---

<section id="features" class="border-b border-paper-300 py-24 sm:py-32 dark:border-navy-800">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mb-16 max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-amber-700 dark:text-amber-500/80">{i.features.eyebrow}</p>
      <h2 class="mt-4 font-display text-display-lg font-medium text-navy-900 dark:text-paper-100 [font-variation-settings:'opsz'_72]">
        {i.features.sectionTitle}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-navy-500 dark:text-paper-100/60">{i.features.sectionSubtitle}</p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        i.features.items.map((item, idx) => (
          <article class="group relative flex flex-col gap-4 rounded-lg border border-paper-300 bg-paper-50 p-7 transition-colors hover:border-amber-600/40 dark:border-navy-800 dark:bg-navy-850/60 dark:hover:border-amber-500/30">
            <div class="flex items-center justify-between">
              <div class="flex h-10 w-10 items-center justify-center rounded-md bg-amber-600/10 text-amber-700 dark:bg-amber-500/10 dark:text-amber-500">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons[idx]} />
              </div>
              <span class="font-mono text-[10px] uppercase tracking-widest text-navy-400 dark:text-paper-100/30">
                {String(idx + 1).padStart(2, '0')}
              </span>
            </div>
            <h3 class="font-display text-xl font-medium text-navy-900 dark:text-paper-100 [font-variation-settings:'opsz'_36]">{item.title}</h3>
            <p class="text-sm leading-relaxed text-navy-500 dark:text-paper-100/60">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
