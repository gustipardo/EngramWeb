---
import type { Locale } from '../i18n';
import { t } from '../i18n';
import PxIcon from './PxIcon.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const p = i.pricing;
---

<section id="pricing" class="scroll-mt-16 rule-t py-16 sm:py-24" aria-labelledby="pricing-h">
  <div class="wrap">
    <SectionHead id="pricing-h" eyebrow={p.eyebrow} title={p.title} lede={p.lede} />

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      <article class="reveal drop">
        <div class="panel plan">
          <p class="kicker">{p.free.label}</p>
          <p class="mt-5 flex items-baseline gap-3">
            <span class="disp text-[72px] leading-none">{p.free.amount}</span>
            <span class="text-[16px] font-medium" style="color:var(--mesa-ink2)">{p.free.unit}</span>
          </p>
          <ul class="mt-7 grid gap-3">
            {
              p.free.features.map((f) => (
                <li class="flex items-start gap-3 text-[15.5px]">
                  <PxIcon name="check" size={14} class="mt-1.5 text-[color:var(--mesa-due)]" />
                  <span>{f}</span>
                </li>
              ))
            }
          </ul>
          <span class="min-h-8 flex-1"></span>
          <a href="#download" class="btn btn-o w-full">{i.nav.cta}</a>
        </div>
      </article>

      <article class="reveal drop" style="transition-delay:80ms">
        <div class="mat plan nt">
          <p class="kicker">{p.pro.label}</p>
          <p class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="sr-only">{p.pro.price}</span>
            <span class="disp flex items-start text-[72px] leading-none" aria-hidden="true">
              {p.pro.priceMain}<span class="cents">{p.pro.priceCents}</span>
            </span>
            <span class="text-[16px] font-medium" style="color:var(--mesa-on-felt2)">{p.pro.per}</span>
          </p>
          <p class="mt-1 font-mono text-[13px]" style="color:var(--mesa-on-felt2)">{p.pro.alt}</p>
          <ul class="mt-6 grid gap-3">
            {
              p.pro.features.map((f) => (
                <li class="flex items-start gap-3 text-[15.5px]">
                  <PxIcon name="check" size={14} class="mt-1.5 text-[color:var(--mesa-back)]" />
                  <span>{f}</span>
                </li>
              ))
            }
          </ul>
          <span class="min-h-8 flex-1"></span>
          <a href="#download" class="btn btn-back w-full">{i.nav.cta}</a>
        </div>
      </article>
    </div>

    <p class="reveal mx-auto mt-10 max-w-2xl text-center font-mono text-[12.5px] leading-relaxed" style="color:var(--mesa-ink3)">
      {p.note}
    </p>
  </div>
</section>

<style>
  .plan {
    --s: 8px;
    --h: 4px;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 4vw, 36px);
    gap: 0;
  }
  .cents {
    font-size: 0.48em;
    margin: 0.12em 0 0 0.06em;
  }
</style>
