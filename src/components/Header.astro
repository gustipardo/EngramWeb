---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const altPath = locale === 'es' ? '/en/' : '/';
const altLabel = locale === 'es' ? 'EN' : 'ES';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-paper-300/70 bg-paper-100/80 backdrop-blur-md transition-colors dark:border-navy-800/60 dark:bg-navy-900/80">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a
      href={locale === 'es' ? '/' : '/en/'}
      class="group flex items-center gap-2.5"
      aria-label="Engram · Conversational Flashcards"
    >
      <!-- Light-theme mark (deep amber on paper) -->
      <svg viewBox="0 0 200 200" width="28" height="28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="shrink-0 transition-transform group-hover:-translate-y-0.5 dark:hidden">
        <rect x="28" y="30" width="108" height="140" rx="11.6" fill="#B87826"/>
        <rect x="51.76" y="68.8" width="60.48" height="6.4" rx="3.2" fill="#FAF7F1"/>
        <rect x="51.76" y="113.6" width="60.48" height="6.4" rx="3.2" fill="#FAF7F1" opacity=".55"/>
        <line x1="150" y1="81" x2="173.12" y2="68.71" stroke="#B87826" stroke-width="7.6" stroke-linecap="round" opacity="0.5"/>
        <line x1="150" y1="100" x2="183.88" y2="100" stroke="#B87826" stroke-width="7.6" stroke-linecap="round" opacity="0.9"/>
        <line x1="150" y1="119" x2="173.12" y2="131.29" stroke="#B87826" stroke-width="7.6" stroke-linecap="round" opacity="0.5"/>
      </svg>
      <!-- Dark-theme mark (bright amber on navy) -->
      <svg viewBox="0 0 200 200" width="28" height="28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="hidden shrink-0 transition-transform group-hover:-translate-y-0.5 dark:block">
        <rect x="28" y="30" width="108" height="140" rx="11.6" fill="#E4A13F"/>
        <rect x="51.76" y="68.8" width="60.48" height="6.4" rx="3.2" fill="#0B1020"/>
        <rect x="51.76" y="113.6" width="60.48" height="6.4" rx="3.2" fill="#0B1020" opacity=".55"/>
        <line x1="150" y1="81" x2="173.12" y2="68.71" stroke="#E4A13F" stroke-width="7.6" stroke-linecap="round" opacity="0.5"/>
        <line x1="150" y1="100" x2="183.88" y2="100" stroke="#E4A13F" stroke-width="7.6" stroke-linecap="round" opacity="0.9"/>
        <line x1="150" y1="119" x2="173.12" y2="131.29" stroke="#E4A13F" stroke-width="7.6" stroke-linecap="round" opacity="0.5"/>
      </svg>
      <span class="font-display text-xl font-medium tracking-tight text-navy-900 dark:text-paper-100">engram</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      <a href="#features" class="text-sm text-navy-500 transition-colors hover:text-navy-900 dark:text-paper-100/70 dark:hover:text-paper-100">{i.nav.features}</a>
      <a href="#how-it-works" class="text-sm text-navy-500 transition-colors hover:text-navy-900 dark:text-paper-100/70 dark:hover:text-paper-100">{i.nav.howItWorks}</a>
      <a href="#pricing" class="text-sm text-navy-500 transition-colors hover:text-navy-900 dark:text-paper-100/70 dark:hover:text-paper-100">{i.nav.pricing}</a>
      <a href="#faq" class="text-sm text-navy-500 transition-colors hover:text-navy-900 dark:text-paper-100/70 dark:hover:text-paper-100">{i.nav.faq}</a>
      <a href={altPath} class="font-mono text-xs uppercase tracking-widest text-navy-400 transition-colors hover:text-amber-700 dark:text-paper-100/50 dark:hover:text-amber-500">{altLabel}</a>
      <a
        href="#download"
        class="rounded-md bg-amber-600 px-4 py-2 text-sm font-semibold text-paper-100 transition-colors hover:bg-amber-700 dark:bg-amber-500 dark:text-navy-900 dark:hover:bg-amber-300"
      >
        {i.nav.download}
      </a>
    </div>

    <div class="flex items-center gap-3 md:hidden">
      <a href={altPath} class="font-mono text-xs uppercase tracking-widest text-navy-500 dark:text-paper-100/60">{altLabel}</a>
      <button id="mobile-menu-btn" class="p-2 text-navy-900 dark:text-paper-100" aria-label="Menu">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-b border-paper-300/70 bg-paper-100/95 px-4 pb-4 md:hidden dark:border-navy-800/60 dark:bg-navy-900/95">
    <a href="#features" class="block py-2 text-navy-700 dark:text-paper-100/80">{i.nav.features}</a>
    <a href="#how-it-works" class="block py-2 text-navy-700 dark:text-paper-100/80">{i.nav.howItWorks}</a>
    <a href="#pricing" class="block py-2 text-navy-700 dark:text-paper-100/80">{i.nav.pricing}</a>
    <a href="#faq" class="block py-2 text-navy-700 dark:text-paper-100/80">{i.nav.faq}</a>
    <a href="#download" class="mt-2 block rounded-md bg-amber-600 px-4 py-2 text-center font-semibold text-paper-100 dark:bg-amber-500 dark:text-navy-900">{i.nav.download}</a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
