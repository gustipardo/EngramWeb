---
import type { Locale } from '../i18n';
import { t } from '../i18n';
import PixelLogo from './PixelLogo.astro';
import PxIcon from './PxIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const home = locale === 'es' ? '/' : '/en/';
const altPath = locale === 'es' ? '/en/' : '/';
const altLang = locale === 'es' ? 'en' : 'es';
const links = [
  { href: '#session', label: i.nav.session },
  { href: '#decks', label: i.nav.decks },
  { href: '#archie', label: i.nav.archie },
  { href: '#pricing', label: i.nav.pricing },
  { href: '#faq', label: i.nav.faq },
];
---

<header class="site-header sticky top-0 z-50">
  <nav class="wrap flex h-16 items-center justify-between gap-4">
    <a href={home} class="flex items-center gap-2.5" aria-label={i.nav.home}>
      <PixelLogo n={24} width={30} />
      <span class="wordmark text-[23px] leading-none">Engram</span>
    </a>

    <ul class="hidden items-center gap-7 lg:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="nav-link">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <button
        type="button"
        class="btn btn-o btn-sm w-9 px-0"
        data-night-toggle
        data-label-day={i.nav.toDay}
        data-label-night={i.nav.toNight}
        aria-label={i.nav.toNight}
      >
        <PxIcon name="moon" class="when-day" />
        <PxIcon name="sun" class="when-night" />
      </button>
      <a href={altPath} hreflang={altLang} lang={altLang} class="btn btn-o btn-sm font-mono text-[13px]" aria-label={i.nav.otherLang}>
        {i.nav.otherLangShort}
      </a>
      <a href="#download" class="btn btn-back btn-sm hidden sm:inline-flex">{i.nav.cta}</a>
      <button type="button" class="btn btn-o btn-sm w-9 px-0 lg:hidden" data-menu-btn aria-expanded="false" aria-controls="site-menu" aria-label={i.nav.menu}>
        <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </nav>

  <div id="site-menu" class="site-menu lg:hidden" data-menu hidden>
    <ul class="wrap grid gap-1 py-3">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="block py-2.5 text-[17px] font-medium">
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2 sm:hidden">
        <a href="#download" class="btn btn-back w-full">{i.nav.cta}</a>
      </li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    background: color-mix(in srgb, var(--mesa-paper) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--mesa-rule);
  }
  .nav-link {
    font: 500 14.5px var(--ui);
    color: var(--mesa-ink2);
    transition: color 0.15s var(--ease);
  }
  .nav-link:hover {
    color: var(--mesa-ink);
  }
  .burger {
    display: grid;
    gap: 3px;
    width: 14px;
  }
  .burger i {
    display: block;
    height: 2px;
    background: currentColor;
  }
  .site-menu {
    border-top: 1px solid var(--mesa-rule);
    background: var(--mesa-paper);
  }
</style>
