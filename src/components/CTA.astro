---
import type { Locale } from '../i18n';
import { t } from '../i18n';
import { PLAY_URL, SUPPORT_EMAIL } from '../lib/site';
import PixelLogo from './PixelLogo.astro';
import PxIcon from './PxIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale).cta;
const href = PLAY_URL || `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent(i.mailSubject)}`;
---

<section id="download" class="mat scroll-mt-16" aria-labelledby="cta-h">
  <div class="wrap grid justify-items-center py-20 text-center sm:py-28">
    <PixelLogo n={96} width={132} animate class="reveal" />
    <h2 id="cta-h" class="disp reveal mt-8 max-w-[18ch] text-[clamp(36px,5.4vw,66px)]">{i.title}</h2>
    {!PLAY_URL && <p class="reveal mt-5 max-w-[34rem] text-[18px] leading-relaxed" style="color:var(--mesa-on-felt2)">{i.body}</p>}
    <a href={href} class="btn btn-back btn-lg drop reveal mt-9">
      <PxIcon name={PLAY_URL ? 'down' : 'mail'} />
      {PLAY_URL ? i.button : i.buttonEarly}
    </a>
    <p class="reveal mt-5 font-mono text-[12px]" style="color:var(--mesa-on-felt2)">{i.hint}</p>
  </div>
</section>
